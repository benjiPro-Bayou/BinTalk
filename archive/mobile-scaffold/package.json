{
  "name": "bintalk-mobile",
  "version": "1.0.0",
  "description": "BinTalk - Mobile client for enterprise communication",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint .",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "xcodebuild -workspace ios/BinTalk.xcworkspace -scheme BinTalk -configuration Release",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle --assets-dest ios",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res"
  },
  "keywords": [
    "communication",
    "messaging",
    "enterprise",
    "p2p",
    "encrypted"
  ],
  "author": "BinTalk Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "@react-redux/hooks": "^1.1.1",
    "react": "^18.2.0",
    "react-native": "^0.72.0",
    "react-native-gesture-handler": "^2.12.0",
    "react-native-reanimated": "^3.3.0",
    "react-native-safe-area-context": "^4.6.0",
    "react-native-screens": "^3.20.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-crypto": "^2.2.2",
    "expo": "^49.0.0",
    "expo-crypto": "^12.0.0",
    "redux": "^4.2.1",
    "react-redux": "^8.1.3",
    "redux-thunk": "^2.4.2",
    "axios": "^1.5.0",
    "socket.io-client": "^4.5.4",
    "moment": "^2.29.4",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.22.0",
    "@react-native/metro-config": "^0.72.0",
    "@testing-library/react-native": "^12.0.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "typescript": "^5.1.0"
  }
}
